# Salin ke .env dan sesuaikan bila perlu.

# Port server
PORT=5000

# Domain upstream (bila oppadrama.io berganti domain)
OPPADRAMA_BASE_URL=https://oppadrama.io

# Kandidat domain cadangan, dipisah koma
OPPADRAMA_DOMAINS=https://oppadrama.io

# Timeout HTTP (detik)
OPPADRAMA_TIMEOUT=25

# TTL cache
OPPADRAMA_CACHE_TTL=300
OPPADRAMA_STREAM_CACHE_TTL=600

# Retry dan batas halaman
OPPADRAMA_MAX_RETRIES=3
OPPADRAMA_MAX_PAGE=500
